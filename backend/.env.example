# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://docchat:docchat@localhost:5433/docchat

# Answering model. claude-haiku-5-5 is much cheaper if you're experimenting.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Local embedding model (runs on CPU, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6

CORS_ORIGINS=http://localhost:3000
